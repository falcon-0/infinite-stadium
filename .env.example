# Server-only settings. Use an Azure model deployment supporting v1 Chat Completions.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=YOUR-KEY

# Portable server settings. Keep loopback binding for local work.
HOST=127.0.0.1
PORT=4173
MAX_DAILY_MODEL_CALLS=40
# MODEL_BUDGET_FILE is required when binding publicly with Azure configured.
# It must name a JSON file directly inside this project's .runtime directory.
# For Docker, mount persistent storage at /app/.runtime, writable by user node.
# Keep the existing ledger and the approved request limit across restarts.
# This counts request reservations, not Azure dollars or distributed replicas.
# MODEL_BUDGET_FILE=.runtime/azure-model-budget.json
# Public binding (HOST=0.0.0.0) requires BOTH settings below, even without AI.
# Use a private APP_ACCESS_TOKEN of at least 32 characters.
# PUBLIC_ORIGIN must be the actual HTTPS site origin, with no path or query.
# HTTPS is supplied by the hosting platform or reverse proxy, not this server.
# APP_ACCESS_TOKEN=
# PUBLIC_ORIGIN=https://your-deployment.example
# Vercel: configure a shared Upstash Redis REST store instead of a disk ledger.
# These values are server-only; do not prefix them with NEXT_PUBLIC_ or expose them.
# UPSTASH_REDIS_REST_URL=https://your-store.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# MODEL_BUDGET_NAMESPACE=infinite-stadium
# Vercel supplies trusted production/deployment hostnames automatically.

# Optional owner-selected project sign-in code (6-128 characters).
# Creates an opaque session; internal APP_ACCESS_TOKEN remains private.
# APP_ACCESS_CODE=
